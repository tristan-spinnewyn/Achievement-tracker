{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FFXIV Achievement Tracker",
  "version": "2.1.1",
  "identifier": "com.shin.ffxiv-achievement-tracker",
  "build": {
    "beforeDevCommand": "npm run tauri:renderer:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run tauri:renderer:build",
    "frontendDist": "../out/tauri-renderer"
  },
  "app": {
    "windows": [
      {
        "title": "FFXIV Achievement Tracker",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: http://asset.localhost https://xivapi.com https://v2.xivapi.com",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../build/icon.ico", "../build/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
