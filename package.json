{
  "name": "ffxiv-achievement-tracker",
  "version": "1.0.1",
  "description": "Suivi et gestion des hauts faits FFXIV (Electron, 100% local)",
  "main": "./out/main/index.js",
  "author": "shin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tristan-spinnewyn/Achievment-tracker.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:catalog": "tsx scripts/build-catalog.ts",
    "build:collections": "tsx scripts/build-collections.ts",
    "make:icon": "node scripts/make-icon.cjs",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "flexsearch": "^0.8.212",
    "react-chartjs-2": "^5.2.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "chart.js": "^4.4.3",
    "cheerio": "^1.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.1",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.27.7": true
  },
  "overrides": {
    "@noble/hashes": "1.8.0",
    "electron-vite": {
      "vite": "$vite"
    }
  }
}
