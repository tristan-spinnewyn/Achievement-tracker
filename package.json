{
  "name": "ffxiv-achievement-tracker",
  "version": "3.0.0",
  "description": "FFXIV achievement tracker (Tauri, 100% local)",
  "author": "shin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tristan-spinnewyn/Achievement-tracker.git"
  },
  "private": true,
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:catalog": "tsx scripts/build-catalog.ts",
    "build:collections": "cargo run --manifest-path src-tauri/Cargo.toml --example build_collections",
    "make:icon": "node scripts/make-icon.cjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:renderer:dev": "vite --config vite.tauri.config.ts",
    "tauri:renderer:build": "vite build --config vite.tauri.config.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --fail-under-lines 80 --ignore-filename-regex \"(main|lib).rs$\""
  },
  "dependencies": {
    "react-chartjs-2": "^5.2.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "chart.js": "^4.6.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.1",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "esbuild@0.27.7": true
  }
}
